<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- Used only in HDFS mode (hdfs-on). The Hadoop folder itself stays standalone, like the lab. -->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://localhost:9000</value>
  </property>
  <property>
    <name>hadoop.tmp.dir</name>
    <value>${user.home}/.hdfs/tmp</value>
  </property>
</configuration>
