{
  "name": "CI51 Big Data Lab",
  "image": "ghcr.io/prorm/bigdata-lab:latest",
  "remoteUser": "rit",
  "containerUser": "rit",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "lab-entrypoint true",
  "forwardPorts": [
    9870,
    4040
  ],
  "portsAttributes": {
    "9870": {
      "label": "HDFS web UI"
    },
    "4040": {
      "label": "Spark UI"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.cwd": "/home/rit"
      }
    }
  }
}
